@page
@model LogoutModel
@{
    ViewData["Title"] = "Signed Out";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-card" style="max-width: 520px;">
    <!-- Kengaytirildi: kengroq forma -->
    <div class="card-body p-5 p-lg-6 text-center">
        <i class="bi bi-check-circle-fill text-success fs-1 mb-4"></i>
        <h2 class="fw-bold mb-3">You have been signed out</h2>
        <p class="text-muted mb-5">Thank you for using Enterprise Finance</p>

        <a asp-controller="Home" asp-action="Logout" class="btn btn-success btn-lg px-5 shadow">
            <i class="bi bi-box-arrow-in-right me-2"></i> Sign In Again
        </a>
    </div>
</div>