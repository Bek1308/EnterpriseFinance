<!-- Views/Budget/Index.cshtml (PlannedTransaction Index bilan bir xil dizayn) -->
@model List<BudgetViewModel>
@{
    ViewData["Title"] = "Budgets";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-lg" style="border-radius: 20px; background: var(--header-bg, linear-gradient(135deg, rgba(34,197,94,0.2), rgba(34,197,94,0.05)));">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h1 class="display-5 fw-bold mb-2">Monthly Budgets</h1>
                        <p class="lead opacity-90 mb-0">Plan and track your monthly income and expense budgets</p>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                        <a asp-action="Create" class="btn btn-success btn-lg shadow">
                            <i class="bi bi-plus-circle-fill me-1"></i> New Budget
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table + Summary Section -->
<div class="row g-4">
    <!-- Left: Table -->
    <div class="col-lg-8">
        <div class="card border-0 shadow h-100" style="border-radius: 20px; background-color: rgba(var(--bs-body-bg-rgb), 0.9); backdrop-filter: blur(8px);">
            <div class="card-body p-5 d-flex flex-column">
                <h5 class="fw-bold mb-4">Budget List (@Model.Count)</h5>
                <div class="table-responsive flex-fill overflow-auto">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Period</th>
                                <th>Category</th>
                                <th class="text-end">Planned Income</th>
                                <th class="text-end">Planned Expense</th>
                                <th class="text-end">Balance</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-wallet2 fs-1 d-block mb-3"></i>
                                        No budgets created yet. Start planning!
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold text-truncate" style="max-width: 200px;" title="@item.Name">
                                            @item.Name
                                        </td>
                                        <td class="fw-semibold">@item.MonthName @item.Year</td>
                                        <td>
                                            @if (string.IsNullOrEmpty(item.CategoryName))
                                            {
                                                <span class="badge bg-secondary">General</span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill px-3 py-2" style="background-color: @item.CategoryColor; color: white;">
                                                    @item.CategoryName
                                                </span>
                                            }
                                        </td>
                                        <td class="text-end text-success fw-bold">+@item.PlannedIncome.ToString("N0")</td>
                                        <td class="text-end text-danger fw-bold">-@item.PlannedExpense.ToString("N0")</td>
                                        <td class="text-end fw-bold @(item.Balance >= 0 ? "text-success" : "text-danger")">
                                            @(item.Balance >= 0 ? "+" : "")@item.Balance.ToString("N0")
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete"
                                               onclick="return confirm('Are you sure you want to delete budget &quot;@item.Name&quot;?');">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Summary -->
    <div class="col-lg-4">
        <div class="card border-0 shadow h-100" style="border-radius: 20px; background-color: rgba(var(--bs-success-rgb), 0.05); backdrop-filter: blur(8px);">
            <div class="card-body p-5 d-flex flex-column">
                <h5 class="fw-bold mb-4">Current Year Summary</h5>
                @{
                    var currentYear = DateTime.Now.Year;
                    var yearBudgets = Model.Where(b => b.Year == currentYear);
                    var totalIncome = yearBudgets.Sum(b => b.PlannedIncome);
                    var totalExpense = yearBudgets.Sum(b => b.PlannedExpense);
                    var totalBalance = totalIncome - totalExpense;
                }
                <div class="mb-4">
                    <small class="text-muted d-block">Total Planned Income (@currentYear)</small>
                    <p class="fs-4 fw-bold text-success mb-0">+@totalIncome.ToString("N0") UZS</p>
                </div>
                <div class="mb-4">
                    <small class="text-muted d-block">Total Planned Expense (@currentYear)</small>
                    <p class="fs-4 fw-bold text-danger mb-0">-@totalExpense.ToString("N0") UZS</p>
                </div>
                <hr>
                <div class="mb-4">
                    <small class="text-muted d-block">Year Balance</small>
                    <p class="fs-3 fw-bold mb-0 @(totalBalance >= 0 ? "text-success" : "text-danger")">
                        @(totalBalance >= 0 ? "+" : "")@totalBalance.ToString("N0") UZS
                    </p>
                </div>
                <div class="flex-fill text-center mt-4">
                    <small class="text-muted">Plan wisely, achieve financial goals</small>
                </div>
            </div>
        </div>
    </div>
</div>