@model List<PlannedTransactionViewModel>
@{
    ViewData["Title"] = "Planned Transactions";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-lg" style="border-radius: 20px; background: var(--header-bg, linear-gradient(135deg, rgba(34,197,94,0.2), rgba(34,197,94,0.05)));">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h1 class="display-5 fw-bold mb-2">Planned Transactions</h1>
                        <p class="lead opacity-90 mb-0">Manage your planned income and expense transactions</p>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                        <a asp-action="Create" class="btn btn-success btn-lg shadow">
                            <i class="bi bi-plus-circle-fill me-1"></i> New Planned
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Table + Summary Section -->
<div class="row g-4">
    <!-- Left Block: Transactions Table (kengaytirildi) -->
    <div class="col-lg-8">
        <div class="card border-0 shadow h-100" style="border-radius: 20px; background-color: rgba(var(--bs-body-bg-rgb), 0.9); backdrop-filter: blur(8px);">
            <div class="card-body p-5 d-flex flex-column">
                <h5 class="fw-bold mb-4">Planned Transactions (@Model.Count)</h5>
                <div class="table-responsive flex-fill overflow-auto">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Amount</th>
                                <th>Category</th>
                                <th>Planned Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-calendar-event fs-1 d-block mb-3"></i>
                                        No planned transactions yet. Create your first one!
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold text-truncate" style="max-width: 150px;" title="@item.Name">
                                            @item.Name
                                        </td>
                                        <td class="fw-bold @(item.IsIncome ? "text-success" : "text-danger")">
                                            @(item.IsIncome ? "+" : "-") @item.Amount.ToString("N0")
                                        </td>
                                        <td>
                                            <span class="badge rounded-pill px-3 py-2" style="background-color: @item.CategoryColor; color: white;">
                                                @item.CategoryName
                                            </span>
                                        </td>
                                        <td class="fw-semibold">@item.PlannedDate</td>
                                        <td>
                                            <span class="badge @(item.Status == "Pending" ? "bg-warning" : item.Status == "Executed" ? "bg-success" : "bg-secondary")">
                                                @item.Status
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.Id" data-name="@item.Name">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Block: Summary & Statistics (kichraytirildi) -->
    <div class="col-lg-4">
        <div class="card border-0 shadow h-100" style="border-radius: 20px; background-color: rgba(var(--bs-success-rgb), 0.05); backdrop-filter: blur(8px);">
            <div class="card-body p-5 d-flex flex-column">
                <h5 class="fw-bold mb-4">Summary & Statistics</h5>
                <div class="row mb-4">
                    <div class="col-6">
                        <small class="text-muted d-block">Total Planned</small>
                        <p class="fs-3 fw-bold mb-0">@Model.Count</p>
                    </div>
                    <div class="col-6 text-end">
                        <small class="text-muted d-block">Pending</small>
                        <p class="fs-3 fw-bold mb-0 text-warning">@Model.Count(i => i.Status == "Pending")</p>
                    </div>
                </div>
                <hr>
                <div class="mb-4">
                    <small class="text-muted d-block">Planned Income</small>
                    <p class="fs-4 fw-bold text-success mb-0">
                        +@Model.Where(i => i.IsIncome).Sum(i => i.Amount).ToString("N0") UZS
                    </p>
                </div>
                <div class="mb-4">
                    <small class="text-muted d-block">Planned Expense</small>
                    <p class="fs-4 fw-bold text-danger mb-0">
                        -@Model.Where(i => !i.IsIncome).Sum(i => i.Amount).ToString("N0") UZS
                    </p>
                </div>
                <hr>
                <div class="flex-fill">
                    <small class="text-muted d-block mb-3">Upcoming Next 7 Planned</small>
                    <div class="overflow-auto" style="max-height: 300px;">
                        <ul class="list-unstyled mb-0">
                            @foreach (var item in Model.OrderBy(i => i.PlannedDate).Take(7))
                            {
                                <li class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                                    <div class="text-truncate me-3" style="max-width: 200px;" title="@item.Name">
                                        <strong>@item.Name</strong><br>
                                        <small class="text-muted">@item.CategoryName</small>
                                    </div>
                                    <div class="text-end">
                                        <span class="fw-semibold @(item.IsIncome ? "text-success" : "text-danger")">
                                            @(item.IsIncome ? "+" : "-") @item.Amount.ToString("N0")
                                        </span><br>
                                        <small class="text-muted">@item.PlannedDate</small>
                                    </div>
                                </li>
                            }
                            @if (!Model.Any())
                            {
                                <li class="text-muted text-center">No upcoming planned transactions</li>
                            }
                        </ul>
                    </div>
                </div>
                <hr class="mt-auto">
                <div class="text-center">
                    <small class="text-muted">Manage your planned transactions effectively</small>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-4">
                <div class="text-center mb-4">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
                </div>
                <p class="text-center mb-0">
                    Are you sure you want to delete the planned transaction <strong id="deletePlannedName"></strong>?
                </p>
                <small class="text-muted d-block text-center mt-3">This action cannot be undone.</small>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-outline-secondary btn-lg px-5" data-bs-dismiss="modal">
                    Cancel
                </button>
                <form id="deleteForm" asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" id="deleteId" name="id" />
                    <button type="submit" class="btn btn-danger btn-lg px-5 shadow">
                        <i class="bi bi-trash me-2"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');
        deleteModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');
            const name = button.getAttribute('data-name');
            const modalName = deleteModal.querySelector('#deletePlannedName');
            const modalId = deleteModal.querySelector('#deleteId');
            modalName.textContent = name;
            modalId.value = id;
        });
    </script>
}