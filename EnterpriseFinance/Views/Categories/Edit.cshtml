@model Category
@{
    ViewData["Title"] = "Kategoriyani Tahrirlash";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-lg"
             style="border-radius: 20px; background: var(--header-bg, linear-gradient(135deg, rgba(34,197,94,0.2), rgba(34,197,94,0.05)));">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h1 class="display-5 fw-bold mb-2">@ViewData["Title"]</h1>
                        <p class="lead opacity-90 mb-0">Update your category details</p>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg me-2">
                            <i class="bi bi-arrow-left-circle me-1"></i> Back
                        </a>
                        <button type="submit" form="categoryForm" class="btn btn-success btn-lg shadow">
                            <i class="bi bi-check-circle-fill me-1"></i> Save
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Form + Info Section -->
<div class="row g-4">
    <!-- Left: Form -->
    <div class="col-lg-7">
        <div class="card border-0 shadow"
             style="border-radius: 20px; background-color: rgba(var(--bs-body-bg-rgb), 0.9); backdrop-filter: blur(8px);">
            <div class="card-body p-5">
                <form asp-action="Edit" method="post" id="categoryForm">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="alert alert-danger mb-4 rounded-3"></div>

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label fw-semibold">Category Name</label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Salary, Marketing" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Type</label>
                        <div class="row g-3">
                            <div class="col-6">
                                <div class="p-4 rounded-3 border text-center cursor-pointer" style="background-color: var(--bs-body-bg);">
                                    <input class="form-check-input" type="radio" asp-for="IsIncome" value="true" id="income" />
                                    <label class="form-check-label fw-semibold d-block mt-2" for="income">
                                        <i class="bi bi-arrow-up-circle text-success fs-3"></i><br>Income
                                    </label>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-4 rounded-3 border text-center cursor-pointer" style="background-color: var(--bs-body-bg);">
                                    <input class="form-check-input" type="radio" asp-for="IsIncome" value="false" id="expense" />
                                    <label class="form-check-label fw-semibold d-block mt-2" for="expense">
                                        <i class="bi bi-arrow-down-circle text-danger fs-3"></i><br>Expense
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Color" class="form-label fw-semibold">Category Color</label>
                        <input type="color" asp-for="Color" class="form-control form-control-color w-100" style="height: 60px;" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="OrderIndex" class="form-label fw-semibold">Display Order</label>
                        <input asp-for="OrderIndex" class="form-control form-control-lg" type="number" value="0" />
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-end gap-3 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-success btn-lg shadow">
                            <i class="bi bi-check-circle-fill me-1"></i> Save Category
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Right: Info Block -->
    <div class="col-lg-5">
        <div class="card border-0 shadow" style="border-radius: 20px; background-color: rgba(var(--bs-success-rgb), 0.05); backdrop-filter: blur(8px);">
            <div class="card-body p-5">
                <h5 class="fw-bold mb-3">Tips & Information</h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-3">
                        <i class="bi bi-info-circle text-success me-2"></i>
                        Use meaningful category names for easy tracking.
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-palette text-primary me-2"></i>
                        Pick distinct colors for categories.
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-sort-numeric-up text-warning me-2"></i>
                        Set display order to prioritize categories.
                    </li>
                    <li class="mb-0">
                        <i class="bi bi-shield-check text-success me-2"></i>
                        Income categories are green, expenses are red by default.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
