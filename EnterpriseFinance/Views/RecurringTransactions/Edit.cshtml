@model RecurringTransaction
@{
    ViewData["Title"] = "Edit Recurring Transaction";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-lg" style="border-radius: 20px; background: var(--header-bg, linear-gradient(135deg, rgba(34,197,94,0.2), rgba(34,197,94,0.05)));">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h1 class="display-5 fw-bold mb-2">@ViewData["Title"]</h1>
                        <p class="lead opacity-90 mb-0">Update recurring transaction settings</p>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg me-2">
                            <i class="bi bi-arrow-left-circle me-1"></i> Back
                        </a>
                        <button type="submit" form="recurringForm" class="btn btn-success btn-lg shadow">
                            <i class="bi bi-check-circle-fill me-1"></i> Save
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Form + Right Sidebar (ikki block teng kenglik va balandlikda) -->
<div class="row g-4">
    <div class="col-lg-6">
        <!-- Left Block: Details -->
        <div class="card border-0 shadow h-100" style="border-radius: 20px; background-color: rgba(var(--bs-body-bg-rgb), 0.9); backdrop-filter: blur(8px);">
            <div class="card-body p-5 d-flex flex-column">
                <h5 class="fw-bold mb-4">Details</h5>
                <form asp-action="Edit" method="post" id="recurringForm">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="All" class="alert alert-danger mb-4 rounded-3"></div>

                    <!-- Name -->
                    <div class="mb-4 flex-fill">
                        <label asp-for="Name" class="form-label fw-bold">Transaction Name</label>
                        <input asp-for="Name" class="form-control form-control-lg" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <!-- Category -->
                    <div class="mb-4 flex-fill">
                        <label asp-for="CategoryId" class="form-label fw-bold">Category</label>
                        <select asp-for="CategoryId" class="form-select form-select-lg" asp-items="ViewBag.Categories"></select>
                    </div>

                    <!-- Description -->
                    <div class="mb-4 flex-fill">
                        <label asp-for="Description" class="form-label fw-bold">Description (optional)</label>
                        <textarea asp-for="Description" class="form-control form-control-lg" rows="5"></textarea>
                    </div>

                    <!-- End Date -->
                    <div class="mb-4 flex-fill">
                        <label asp-for="EndDate" class="form-label fw-bold">End Date (optional)</label>
                        <input asp-for="EndDate" class="form-control form-control-lg" type="date" />
                        <small class="text-muted">Leave empty for indefinite recurring</small>
                    </div>

                    <!-- Conditional Fields (DayOfWeek / DayOfMonth) -->
                    <div id="conditionalFields" class="mb-4 flex-fill">
                        @if (Model.Frequency == "Weekly")
                        {
                            <div>
                                <label asp-for="DayOfWeek" class="form-label fw-bold">Day of Week</label>
                                <select asp-for="DayOfWeek" class="form-select form-select-lg">
                                    <option value="">-- Select day --</option>
                                    <option value="Monday">Monday</option>
                                    <option value="Tuesday">Tuesday</option>
                                    <option value="Wednesday">Wednesday</option>
                                    <option value="Thursday">Thursday</option>
                                    <option value="Friday">Friday</option>
                                    <option value="Saturday">Saturday</option>
                                    <option value="Sunday">Sunday</option>
                                </select>
                            </div>
                        }

                        @if (Model.Frequency == "Monthly")
                        {
                            <div>
                                <label asp-for="DayOfMonth" class="form-label fw-bold">Day of Month</label>
                                <input asp-for="DayOfMonth" class="form-control form-control-lg text-center" type="number" min="1" max="31" />
                                <small class="text-muted">31 = last day of month</small>
                            </div>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <!-- Right Block: Key Settings + Buttons -->
        <div class="card border-0 shadow h-100" style="border-radius: 20px; background-color: rgba(var(--bs-body-bg-rgb), 0.9); backdrop-filter: blur(8px);">
            <div class="card-body p-5 d-flex flex-column">
                <h5 class="fw-bold mb-4">Key Settings</h5>

                <!-- Amount -->
                <div class="mb-4 flex-fill">
                    <label asp-for="Amount" class="form-label fw-bold">Amount</label>
                    <div class="input-group">
                        <span class="input-group-text fw-bold">UZS</span>
                        <input asp-for="Amount" class="form-control form-control-lg text-end fw-bold" style="font-size: 1.8rem;" form="recurringForm" />
                    </div>
                </div>

                <!-- Type -->
                <div class="mb-4 flex-fill">
                    <label class="form-label fw-semibold">Type</label>
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-4 rounded-3 border text-center cursor-pointer type-box @(Model.IsIncome == true ? "border-success border-3" : "")">
                                <input class="form-check-input" type="radio" asp-for="IsIncome" value="true" id="income" form="recurringForm" />
                                <label class="form-check-label fw-semibold d-block mt-2" for="income">
                                    <i class="bi bi-arrow-up-circle text-success fs-3"></i><br>Income
                                </label>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-4 rounded-3 border text-center cursor-pointer type-box @(Model.IsIncome == false ? "border-danger border-3" : "")">
                                <input class="form-check-input" type="radio" asp-for="IsIncome" value="false" id="expense" form="recurringForm" />
                                <label class="form-check-label fw-semibold d-block mt-2" for="expense">
                                    <i class="bi bi-arrow-down-circle text-danger fs-3"></i><br>Expense
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Frequency -->
                <div class="mb-4 flex-fill">
                    <label asp-for="Frequency" class="form-label fw-bold">Frequency</label>
                    <select asp-for="Frequency" class="form-select form-select-lg" form="recurringForm">
                        <option value="Daily">Daily</option>
                        <option value="Weekly">Weekly</option>
                        <option value="Monthly">Monthly</option>
                        <option value="Yearly">Yearly</option>
                    </select>
                </div>

                <!-- Interval -->
                <div class="mb-4 flex-fill">
                    <label asp-for="Interval" class="form-label fw-bold">Interval</label>
                    <input asp-for="Interval" class="form-control form-control-lg text-center" type="number" min="1" form="recurringForm" />
                </div>

                <!-- Start Date -->
                <div class="mb-4 flex-fill">
                    <label asp-for="StartDate" class="form-label fw-bold">Start Date</label>
                    <input asp-for="StartDate" class="form-control form-control-lg" type="date" form="recurringForm" />
                </div>

                <!-- Buttons (pastda) -->
                <div class="mt-auto d-flex flex-column gap-3">
                    <button type="submit" form="recurringForm" class="btn btn-success btn-lg shadow">
                        <i class="bi bi-check-circle-fill me-2"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-x-circle me-2"></i> Cancel
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Type box selection
        document.querySelectorAll('.type-box').forEach(box => {
            box.addEventListener('click', function () {
                document.querySelectorAll('.type-box').forEach(b => {
                    b.classList.remove('border-success', 'border-danger', 'border-3');
                });

                const radio = this.querySelector('input[type="radio"]');
                if (radio.value === 'true') {
                    this.classList.add('border-success', 'border-3');
                } else {
                    this.classList.add('border-danger', 'border-3');
                }

                radio.checked = true;
            });
        });

        // Initial active type
        const checkedRadio = document.querySelector('input[type="radio"][name="IsIncome"]:checked');
        if (checkedRadio) {
            const box = checkedRadio.closest('.type-box');
            if (box) {
                if (checkedRadio.value === 'true') {
                    box.classList.add('border-success', 'border-3');
                } else {
                    box.classList.add('border-danger', 'border-3');
                }
            }
        }
    </script>
}