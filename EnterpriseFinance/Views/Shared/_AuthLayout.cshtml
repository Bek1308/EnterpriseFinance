<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise Finance</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #111827 0%, #030712 100%);
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
        }

        [data-bs-theme="light"] body {
            background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
        }

        .auth-card {
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            max-width: 420px;
            width: 100%;
        }

        [data-bs-theme="light"] .auth-card {
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(0, 0, 0, 0.1);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .form-control {
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.3);
            color: #e5e7eb;
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 1.1rem;
        }

        [data-bs-theme="light"] .form-control {
            border-color: rgba(0, 0, 0, 0.2);
            color: #1f2937;
        }

        .form-control:focus {
            background: transparent;
            border-color: #22c55e;
            box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.2);
            color: #e5e7eb;
        }

        [data-bs-theme="light"] .form-control:focus {
            color: #1f2937;
        }

        .form-label {
            color: #e5e7eb;
            font-weight: 500;
        }

        [data-bs-theme="light"] .form-label {
            color: #4b5563;
        }

        .btn-success {
            background: #22c55e;
            border: none;
            border-radius: 12px;
            padding: 16px;
            font-weight: 600;
            font-size: 1.1rem;
            box-shadow: 0 8px 20px rgba(34, 197, 94, 0.3);
            transition: all 0.3s ease;
        }

            .btn-success:hover {
                background: #16a34a;
                transform: translateY(-3px);
                box-shadow: 0 12px 25px rgba(34, 197, 94, 0.4);
            }

        .text-muted {
            color: #9ca3af !important;
        }

        .link-success {
            color: #22c55e;
            text-decoration: none;
            font-weight: 500;
        }

            .link-success:hover {
                color: #16a34a;
                text-decoration: underline;
            }

        .logo-text {
            font-size: 2.8rem;
            font-weight: 800;
            background: linear-gradient(90deg, #22c55e, #86efac);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        [data-bs-theme="light"] .logo-text {
            background: linear-gradient(90deg, #15803d, #22c55e);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>
<body>
    <div class="container-fluid d-flex align-items-center justify-content-center min-vh-100 px-4">
        <div class="w-100" style="max-width: 500px;">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>