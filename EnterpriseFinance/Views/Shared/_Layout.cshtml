<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enterprise Finance</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --sidebar-width: 250px;
            --sidebar-collapsed: 80px;
            /* Graphite + Green */
            --sidebar-bg-light: #111827;
            --sidebar-bg-dark: #030712;
            --sidebar-text: #e5e7eb;
            --sidebar-hover-bg: rgba(34,197,94,0.22);
            --sidebar-hover-collapsed: rgba(34,197,94,0.14);
            --top-height: 70px;
        }

        .sidebar {
            width: var(--sidebar-width);
            min-height: 100vh;
            background-color: var(--sidebar-bg-light);
            color: var(--sidebar-text);
            position: fixed;
            top: 0;
            left: 0;
            transition: width 0.3s ease;
            z-index: 1000;
            overflow: hidden;
            border-right: 1px solid #495057;
        }

        [data-bs-theme="dark"] .sidebar {
            background-color: var(--sidebar-bg-dark);
            border-right: 1px solid #2d2d2d;
        }

        .sidebar.collapsed {
            width: var(--sidebar-collapsed);
        }

        /* Logo */
        .sidebar-header {
            height: var(--top-height);
            background-color: inherit;
            display: flex;
            align-items: center;
            justify-content: center;
            border-bottom: 1px solid #495057;
        }

        [data-bs-theme="dark"] .sidebar-header {
            border-bottom-color: #2d2d2d;
        }

        .sidebar-header h5 {
            margin: 0;
            font-weight: 700;
        }

        .sidebar-header small {
            font-size: 0.8rem;
            opacity: 0.8;
        }

        .sidebar.collapsed .sidebar-header small {
            display: none;
        }

        .sidebar .nav {
            padding: 0 10px;
        }

        .sidebar .nav-link {
            color: var(--sidebar-text) !important;
            padding: 14px 15px;
            transition: all 0.3s;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            border-radius: 10px;
            margin: 4px 8px;
        }

        /* Ochiq holatda hover va active */
        .sidebar:not(.collapsed) .nav-link:hover,
        .sidebar:not(.collapsed) .nav-link.active {
            background-color: var(--sidebar-hover-bg);
            color: white !important;
        }

        /* Yopiq holatda yumshoq hover */
        .sidebar.collapsed .nav-link {
            padding: 16px 0;
            justify-content: center;
            margin: 4px 8px;
        }

            .sidebar.collapsed .nav-link:hover {
                background-color: var(--sidebar-hover-collapsed);
            }

            .sidebar.collapsed .nav-link.active {
                background-color: var(--sidebar-hover-bg);
            }

        .sidebar .nav-link i {
            font-size: 1.4rem;
            min-width: 40px;
            text-align: center;
        }

        .sidebar .text {
            opacity: 1;
            transition: opacity 0.2s ease;
            white-space: nowrap;
        }

        .sidebar.collapsed .text {
            opacity: 0;
            width: 0;
            overflow: hidden;
        }

        .main-content {
            margin-left: var(--sidebar-width);
            transition: margin-left 0.3s ease;
            min-height: 100vh;
            padding-top: calc(var(--top-height) + 20px);
            padding-left: 40px;
            padding-right: 40px;
        }

            .main-content.expanded {
                margin-left: var(--sidebar-collapsed);
            }

        .top-navbar {
            height: var(--top-height);
            background-color: var(--sidebar-bg-light) !important;
            color: var(--sidebar-text);
            position: fixed;
            top: 0;
            left: var(--sidebar-width);
            right: 0;
            z-index: 999;
            transition: left 0.3s ease;
        }

        [data-bs-theme="dark"] .top-navbar {
            background-color: var(--sidebar-bg-dark) !important;
        }

        .top-navbar.expanded {
            left: var(--sidebar-collapsed);
        }

        .top-navbar .toggle-btn,
        .top-navbar .theme-toggle,
        .top-navbar .dropdown-toggle {
            color: var(--sidebar-text);
            opacity: 0.9;
            transition: opacity 0.3s;
        }

            .top-navbar .toggle-btn:hover,
            .top-navbar .theme-toggle:hover {
                opacity: 1;
            }

        .top-navbar h5 {
            color: var(--sidebar-text);
            font-weight: 600;
        }

        .theme-toggle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: transparent;
            border: 1px solid rgba(255,255,255,0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

            .theme-toggle:hover {
                background-color: rgba(255,255,255,0.1);
                border-color: rgba(255,255,255,0.4);
            }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="text-center">
                <h5 class="mb-0">EF</h5>
                <small class="text">Finance</small>
            </div>
        </div>

        <nav class="nav flex-column mt-3">
            <a class="nav-link active" href="/Home/Index">
                <i class="bi bi-speedometer2"></i>
                <span class="text">Dashboard</span>
            </a>
            <a class="nav-link" href="/Transactions">
                <i class="bi bi-arrow-left-right"></i>
                <span class="text">Transactions</span>
            </a>
            <a class="nav-link" href="/Categories">
                <i class="bi bi-tags"></i>
                <span class="text">Categories</span>
            </a>
            <a class="nav-link" href="/PlannedTransactions">
                <i class="bi bi-calendar-check"></i>
                <span class="text">Planned</span>
            </a>
            <a class="nav-link" href="/RecurringTransactions">
                <i class="bi bi-arrow-repeat"></i>
                <span class="text">Recurring</span>
            </a>
            <a class="nav-link" href="/Budget">
                <i class="bi bi-pie-chart"></i>
                <span class="text">Budget</span>
            </a>
            <hr class="mx-3 opacity-25 my-4" />
            <a class="nav-link" href="/Tenants">
                <i class="bi bi-building"></i>
                <span class="text">Tenants</span>
            </a>
        </nav>
    </div>

    <!-- Top Navbar -->
    <nav class="top-navbar" id="topNavbar">
        <div class="container-fluid h-100 d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="toggle-btn me-4" id="toggleSidebar">
                    <i class="bi bi-list"></i>
                </div>
                <h5 class="mb-0">@ViewData["Title"]</h5>
            </div>

            <div class="d-flex align-items-center gap-3">
                <button class="theme-toggle" id="themeToggle" title="Toggle Theme">
                    <i class="bi bi-moon-stars-fill"></i>
                </button>

                <div class="dropdown">
                    <a class="d-flex align-items-center text-decoration-none dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle fs-3"></i>
                        <span class="ms-2 d-none d-lg-inline">@User.Identity?.Name</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" href="#">Profile</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item text-danger" asp-area="Identity" asp-page="/Account/Logout"
                               asp-route-returnUrl="@Url.Action("Index", "Home")">
                                Logout
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="main-content" id="mainContent">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sidebar = document.getElementById('sidebar');
        const topNavbar = document.getElementById('topNavbar');
        const mainContent = document.getElementById('mainContent');
        const toggleBtn = document.getElementById('toggleSidebar');
        const themeToggle = document.getElementById('themeToggle');
        const html = document.documentElement;
        const icon = themeToggle.querySelector('i');

        toggleBtn.addEventListener('click', () => {
            sidebar.classList.toggle('collapsed');
            topNavbar.classList.toggle('expanded');
            mainContent.classList.toggle('expanded');
        });

        if (localStorage.getItem('theme') === 'dark') {
            html.setAttribute('data-bs-theme', 'dark');
            icon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
        }

        themeToggle.addEventListener('click', () => {
            if (html.getAttribute('data-bs-theme') === 'dark') {
                html.setAttribute('data-bs-theme', 'light');
                icon.classList.replace('bi-sun-fill', 'bi-moon-stars-fill');
                localStorage.setItem('theme', 'light');
            } else {
                html.setAttribute('data-bs-theme', 'dark');
                icon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
                localStorage.setItem('theme', 'dark');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>