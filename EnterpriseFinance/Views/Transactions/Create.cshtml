@model Transaction
@{
    ViewData["Title"] = "Create Transaction";
}

<!-- Page Header -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 shadow-lg" style="border-radius: 20px; background: var(--header-bg, linear-gradient(135deg, rgba(34,197,94,0.2), rgba(34,197,94,0.05)));">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h1 class="display-5 fw-bold mb-2">@ViewData["Title"]</h1>
                        <p class="lead opacity-90 mb-0">Record a new income or expense transaction</p>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg me-2">
                            <i class="bi bi-arrow-left-circle me-1"></i> Back
                        </a>
                        <button type="submit" form="transactionForm" class="btn btn-success btn-lg shadow">
                            <i class="bi bi-check-circle-fill me-1"></i> Save
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Form + Info Section -->
<div class="row g-4">
    <!-- Left: Form -->
    <div class="col-lg-7">
        <div class="card border-0 shadow" style="border-radius: 20px; background-color: rgba(var(--bs-body-bg-rgb), 0.9); backdrop-filter: blur(8px);">
            <div class="card-body p-5">
                <form asp-action="Create" method="post" id="transactionForm">
                    <div asp-validation-summary="All" class="alert alert-danger mb-4 rounded-3"></div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Transaction Name</label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Salary December, Office Rent" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CategoryId" class="form-label fw-bold">Category</label>
                        <select asp-for="CategoryId" class="form-select form-select-lg" asp-items="ViewBag.Categories">
                            <option value="">-- Select category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Amount" class="form-label fw-bold">Amount</label>
                        <div class="input-group">
                            <span class="input-group-text fw-bold">UZS</span>
                            <input asp-for="Amount" class="form-control form-control-lg text-end fw-bold" style="font-size: 1.8rem;" placeholder="0" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Date" class="form-label fw-bold">Date</label>
                        <input asp-for="Date" class="form-control form-control-lg" type="date" />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold">Description (optional)</label>
                        <textarea asp-for="Description" class="form-control form-control-lg" rows="4" placeholder="Additional notes..."></textarea>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-success btn-lg shadow">
                            <i class="bi bi-check-circle-fill me-2"></i> Save Transaction
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-x-circle me-2"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Right: Info Block -->
    <div class="col-lg-5">
        <div class="card border-0 shadow" style="border-radius: 20px; background-color: rgba(var(--bs-success-rgb), 0.05); backdrop-filter: blur(8px);">
            <div class="card-body p-5">
                <h5 class="fw-bold mb-3">Tips & Information</h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-3">
                        <i class="bi bi-info-circle text-success me-2"></i>
                        Give each transaction a clear name for easy searching.
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-tags text-primary me-2"></i>
                        Select the correct category for accurate reporting.
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-calendar-event text-warning me-2"></i>
                        Use the correct date for monthly reports.
                    </li>
                    <li class="mb-3">
                        <i class="bi bi-currency-dollar text-success me-2"></i>
                        Income is green, expense is red.
                    </li>
                    <li class="mb-0">
                        <i class="bi bi-shield-check text-success me-2"></i>
                        All data is securely stored for your company only.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}